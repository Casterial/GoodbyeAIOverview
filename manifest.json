{
  "manifest_version": 3,
  "name": "Goodbye AI Overview",
  "version": "1.1",
  "description": "Automatically appends -ai to Google searches.",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.ca/*",
        "https://www.google.co.uk/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
