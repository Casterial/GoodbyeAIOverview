{
  "manifest_version": 3,
  "name": "Goodbye AI Overview",
  "version": "1.2",
  "description": "Hides Google's AI Overview from search results.",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
